{
	"$schema": "https://opencode.ai/config.json",
	"model": "openai/gpt-5.6-sol",
	"default_agent": "plan",
	"agent": {
		"plan": {
			"model": "openai/gpt-5.6-sol"
		},
		"build": {
			"model": "openai/gpt-5.6-terra"
		}
	},
	"mcp": {
		"next-devtools": {
			"type": "local",
			"command": ["npx", "-y", "next-devtools-mcp@latest"]
		},
		"Sentry": {
			"type": "remote",
			"url": "https://mcp.sentry.dev/mcp/planned/planned-ui"
		},
		"context7": {
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
			"enabled": true
		},
		"planned": {
			"type": "remote",
			"url": "https://functions.api.planned.com/mcp",
			"timeout": 60000,
			"enabled": true
		},
		"planned-client-local": {
			"type": "remote",
			"url": "http://localhost:3000/client-mcp",
			"timeout": 60000,
			"enabled": true
		},
		"planned-local": {
			"type": "remote",
			"url": "http://localhost:3000/mcp",
			"timeout": 60000,
			"enabled": false
		},
		"Linear": {
			"type": "remote",
			"url": "https://mcp.linear.app/mcp"
		}
	},
	"plugin": ["@mohak34/opencode-notifier@latest"],
	"permission": {
		"bash": {
			"rm -rf *": "deny",
			"rm -fr *": "deny",
			"sudo rm -rf *": "deny",
			"sudo rm -fr *": "deny",
      "sudo *": "ask",
      "git push *--force*": "ask",
      "git reset --hard*": "ask",
      "git clean -f*": "ask",
		},
		"skill": {
			"caveman": "allow",
			"caveman-commit": "allow",
			"caveman-review": "allow",
			"caveman-help": "allow",
			"caveman-compress": "allow"
		}
	},
	"autoshare": false,
	"autoupdate": true
}
